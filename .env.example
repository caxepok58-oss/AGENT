# Copy this file to .env and fill in the keys you have. Every integration is
# optional except the LLM — a cloud API key or a local model (no key needed).
# The pipeline degrades gracefully (falls back to generated placeholder visuals,
# skips Google Trends, etc.) when a key is missing, but it needs an LLM to write
# scripts and metadata. See docs/SETUP.md for step-by-step instructions.

# --- LLM (required: a cloud API key, OR a local model that needs no key) ----
# The provider is normally set in config/config.yaml (providers.llm). Setting
# LLM_PROVIDER here overrides it for this machine: anthropic | openai | ollama.
# LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model, no API key and no account (see docs/SETUP.md, "Local model"):
#   1. install Ollama (https://ollama.com) and run: ollama pull qwen2.5:7b
#   2. set LLM_MODEL above to qwen2.5:7b and uncomment the next line:
# LLM_PROVIDER=ollama
# Only if Ollama (or LM Studio, vLLM, a hosted OpenAI-compatible service) runs
# somewhere other than http://localhost:11434/v1:
# OPENAI_BASE_URL=

# --- Text-to-speech (optional: edge-tts needs no key) -------------------
# Overrides providers.tts from config.yaml when set: edge | elevenlabs
# TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock footage behind the captions (optional, free) ------------------
# Without one of these (or your own clips in config/footage) videos are captions
# over a plain gradient. Pixabay: register at pixabay.com, then open
# pixabay.com/api/docs to see your key. Pexels works the same way at
# pexels.com/api.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Google Trends (optional, no key needed but can be flaky) -----------
GOOGLE_TRENDS_ENABLED=true

# --- YouTube Data API ----------------------------------------------------
# An API key is enough for read-only trend research. Uploading additionally
# requires OAuth credentials (client_secret.json) — see SETUP.md.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
YOUTUBE_TOKEN_FILE=./youtube_token.json

# --- Local paths ----------------------------------------------------------
SHORTS_AGENT_CONFIG=./config/config.yaml
SHORTS_AGENT_DB=./data/shorts_agent.db
SHORTS_AGENT_OUTPUT_DIR=./output
