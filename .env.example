# Copy this file to .env and fill in the keys you have. Every integration is
# optional except the LLM key — the pipeline degrades gracefully (falls back
# to generated placeholder visuals, skips Google Trends, etc.) when a key is
# missing, but it needs at least one LLM provider to write scripts/metadata.
# See SETUP.md for step-by-step instructions on obtaining each key.

# --- LLM (required: pick one provider) ---------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Text-to-speech (optional: edge-tts needs no key) -------------------
TTS_PROVIDER=edge                # edge | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Stock visuals (optional: falls back to generated cards) ------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Google Trends (optional, no key needed but can be flaky) -----------
GOOGLE_TRENDS_ENABLED=true

# --- YouTube Data API ----------------------------------------------------
# An API key is enough for read-only trend research. Uploading additionally
# requires OAuth credentials (client_secret.json) — see SETUP.md.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
YOUTUBE_TOKEN_FILE=./youtube_token.json

# --- Local paths ----------------------------------------------------------
SHORTS_AGENT_CONFIG=./config/config.yaml
SHORTS_AGENT_DB=./data/shorts_agent.db
SHORTS_AGENT_OUTPUT_DIR=./output
